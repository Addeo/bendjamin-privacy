      "blocks": [
        {
          "type": "h3",
          "text": "Verilerinizi satmıyoruz"
        },
        {
          "type": "p",
          "text": "Bendgamine kişisel bilgilerinizi üçüncü taraflara satmaz, takas etmez veya kiralamaz."
